// バス時刻表アプリケーション データベーススキーマ
// PostgreSQLを使用し、Supabaseでホスティング
// 全てのモデルにタイムスタンプを付与し、変更履歴を追跡

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// バス路線の基本情報を管理
model Route {
  // 基本情報
  id        String @id @db.VarChar(10)
  name      String @db.VarChar(100)
  color     String @db.VarChar(7)
  
  // 運行管理
  displayOrder Int     @default(0) @map("display_order")
  isActive    Boolean @default(true) @map("is_active")
  
  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // リレーション
  routeStops RouteStop[]
  departures Departure[]

  // インデックスと設定
  @@index([displayOrder])
  @@index([isActive])
  @@map("routes")
}

// バス停留所の基本情報を管理
model Stop {
  // 基本情報
  id          String   @id @db.VarChar(10)
  name        String   @db.VarChar(100)
  latitude    Decimal? @db.Decimal(8, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  description String?  @db.Text

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // リレーション
  routeStops RouteStop[]
  departures Departure[]

  // インデックスと設定
  @@index([name])
  @@index([latitude, longitude])
  @@map("stops")
}

// 路線とバス停の関連付けと順序を管理
model RouteStop {
  // 関連キー
  routeId String @map("route_id") @db.VarChar(10)
  stopId  String @map("stop_id") @db.VarChar(10)

  // 運行情報
  stopOrder Int  @map("stop_order")
  duration Int? @map("duration_minutes")

  // リレーション
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  // インデックスと設定
  @@id([routeId, stopId])
  @@index([stopOrder])
  @@map("route_stops")
}

// バスの発車時刻情報を管理
model Departure {
  // 基本情報
  id           Int      @id @default(autoincrement())
  routeId      String   @map("route_id") @db.VarChar(10)
  stopId       String   @map("stop_id") @db.VarChar(10)
  departureTime String   @map("departure_time") @db.VarChar(5)
  daysOfWeek   String[] @map("days_of_week")

  // 期間限定運行情報
  seasonStart DateTime? @map("season_start")
  seasonEnd   DateTime? @map("season_end")

  // タイムスタンプ
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // リレーション
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  // インデックスと設定
  @@index([routeId, stopId])
  @@index([departureTime])
  @@index([seasonStart, seasonEnd])
  @@map("departures")
}
